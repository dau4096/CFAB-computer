//fizzbuzz.cfab//

$numLoops = #32
$iter = #1

:loop
//Tracks if either was output.
$saidEither = #0

//Every 3, say "Fizz"
//When condition evals to #0, prints. Otherwise skips
if ($iter % #3) then-goto :after3
PRINT "Fizz\n"
$saidEither = #1
:after3

//Every 5, say "Buzz"
//When condition evals to #0, prints. Otherwise skips
if ($iter % #5) then-goto :after5
PRINT "Buzz\n"
$saidEither = #1
:after5

//Otherwise say the number.
//When condition evals to #0, prints. Otherwise skips
if ($saidEither == #1) then-goto :afterNumber
COUT $iter \n
:afterNumber

COUT #x0A
//0x0A is newline char

$iter ++
if ($iter < $numLoops) then-goto :loop