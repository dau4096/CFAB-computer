/*
Testing new features.
Multi-line comments!
*/

//Now allows for semicolon newlines.
//Testing inline set operations;
r0 = (#1 + #2); PRINT "r0 = (#1 + #2) = "; COUT r0 \n;
r1 = (#11 % r0); PRINT "r1 = (#11 % r0) = "; COUT r1 \n;
r12 = (#10 / #2); PRINT "r12 = (#10 / #2) = "; COUT r12 \n;


PRINT "$A = "; //The $A seems to get removed by accident - need to fix.
$A = #7; COUT $A;
PRINT " --{+2}-> ";
$A = ($A + #2); COUT $A \n;

//ROM definition.
ROM8 0123456789ABCDEF AAAFFAFA AAFAFDDD //Test line comment
ROM6 aaaaaaa /* Test block comment */
$itemSprite @ ROM6
