$previous @ r0
$current @ r1
$iteration @ r2


//Setup
$previous = #1
$current = #1

COUT $previous \n
COUT $current \n


//Fibonacci sequence
:loop
$previous + $current
$current ~ $previous
rOP ~ $current

//Show current value.
COUT $current \n

//Loop if not exceeding maximum iterations
$iteration ++
if ($iteration < #9) then-goto :loop


